# --- Master chat -----------------------------------------------------------
# Zonder deze sleutel werkt de hele ERP, alleen de chat geeft een nette melding.
ANTHROPIC_API_KEY=

# --- Supabase --------------------------------------------------------------
# Nog niet nodig: de app draait op seed-data tot deze zijn ingevuld.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- WooCommerce: wtw-winkel.nl --------------------------------------------
# WooCommerce > Instellingen > Geavanceerd > REST API > sleutel (lezen/schrijven)
WOO_WTW_WINKEL_URL=https://wtw-winkel.nl
WOO_WTW_WINKEL_KEY=
WOO_WTW_WINKEL_SECRET=

# --- WooCommerce: wtwstore.com ---------------------------------------------
WOO_WTWSTORE_URL=https://wtwstore.com
WOO_WTWSTORE_KEY=
WOO_WTWSTORE_SECRET=
